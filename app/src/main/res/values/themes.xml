<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeatherNow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/navy_blue</item>
        <item name="colorSecondary">@color/white</item>
        <item name="android:windowBackground">@color/light_blue</item>

        <!-- Custom Text Appearances as required -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.WeatherNow.HeadlineMedium</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.WeatherNow.BodyMedium</item>
    </style>

    <style name="TextAppearance.WeatherNow.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/navy_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WeatherNow.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/gray_text</item>
    </style>

    <style name="Theme.WeatherNow.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/navy_blue</item>
        <item name="android:statusBarColor">@color/navy_blue</item>
    </style>

    <style name="Theme.WeatherNow" parent="Base.Theme.WeatherNow" />
</resources>