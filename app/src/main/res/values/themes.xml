<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeatherNow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/deep_navy</item>
        <item name="colorSecondary">@color/white</item>
        <item name="backgroundColor">@color/solitude</item>
    </style>

    <style name="Theme.WeatherNow" parent="Base.Theme.WeatherNow" />

    <style name="TextAppearance.MyApp.Text"
        parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/merriweather_italic_variablefont</item>
    </style>

    <style name="TextAppearance.MyApp.HeadlineLarge"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/elmssans_variablefont_wght</item>
    </style>

</resources>